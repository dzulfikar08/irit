---
// Headline result, drawn to scale. Every number comes from docs/benchmarks.md
// ("leanqc against FastQC", 1 file of 1M reads, Ryzen 5 PRO 4650U laptop). Update both together.
const rows = [
	{
		metric: 'Wall time',
		unit: 's',
		fastqc: 7.0,
		leanqc: 2.5,
		format: (n: number) => n.toFixed(1),
	},
	{
		metric: 'Peak memory',
		unit: 'MB',
		fastqc: 483,
		leanqc: 16,
		format: (n: number) => n.toLocaleString('en'),
	},
];
const pct = (part: number, whole: number) => `${((part / whole) * 100).toFixed(2)}%`;
---

<div class="measured not-content">
	{
		rows.map((r) => (
			<figure class="metric">
				<figcaption>{r.metric}</figcaption>
				<dl>
					<div class="row lean">
						<dt>leanqc</dt>
						<dd>
							<span class="bar" style={`--w: ${pct(r.leanqc, r.fastqc)}`} aria-hidden="true" />
							<span class="value">
								{r.format(r.leanqc)} {r.unit}
							</span>
						</dd>
					</div>
					<div class="row ref">
						<dt>FastQC 0.12.1</dt>
						<dd>
							<span class="bar" style="--w: 100%" aria-hidden="true" />
							<span class="value">
								{r.format(r.fastqc)} {r.unit}
							</span>
						</dd>
					</div>
				</dl>
			</figure>
		))
	}
</div>

<style>
	.measured {
		display: grid;
		gap: 2rem;
		margin-block: 1.5rem 1.25rem;
	}
	.metric {
		margin: 0;
	}
	figcaption {
		font-size: var(--sl-text-sm);
		font-weight: 650;
		color: var(--sl-color-white);
		margin-block-end: 0.5rem;
	}
	dl {
		margin: 0;
		display: grid;
		gap: 0.375rem;
	}
	.row {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		align-items: center;
		gap: 1rem;
	}
	dt {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.lean dt {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	dd {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}
	.bar {
		/* Scaled so the largest value fills the track; the smallest stays visible. */
		flex: 0 0 auto;
		width: max(3px, calc(var(--w) * 0.78));
		height: 1.375rem;
		border-radius: 2px;
		background: var(--irit-ref-bar);
	}
	.lean .bar {
		background: var(--irit-soga);
	}
	.value {
		font-variant-numeric: tabular-nums;
		font-size: var(--sl-text-base);
		white-space: nowrap;
		color: var(--sl-color-gray-2);
	}
	.lean .value {
		color: var(--sl-color-white);
		font-weight: 700;
	}
	@media (max-width: 34rem) {
		.row {
			grid-template-columns: 1fr;
			gap: 0.125rem;
		}
		.bar {
			width: max(3px, calc(var(--w) * 0.62));
		}
	}
</style>
